# ====================================================================
# DATABASE (Supabase PostgreSQL Connection)
# ====================================================================
# Find these in Supabase Dashboard -> Project Settings -> Database -> Connection String
# Transaction Pooler connection string (Port 6543, pool_mode=transaction)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ====================================================================
# SUPABASE API KEYS (Project Settings -> API)
# ====================================================================
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ====================================================================
# AI & LLM PROVIDER KEYS (Optional for Live Model Inference)
# ====================================================================
# Hugging Face Access Token (Free at https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY="hf_your_huggingface_access_token_here"

# Groq API Key (Free, ultra-fast 70B inference at https://console.groq.com/keys)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# ====================================================================
# FASTAPI BACKEND SERVER URL
# ====================================================================
NEXT_PUBLIC_FASTAPI_URL="http://localhost:8000"
